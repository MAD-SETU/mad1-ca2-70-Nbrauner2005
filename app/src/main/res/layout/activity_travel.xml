<?xml version="1.0" encoding="utf-8"?>

<!-- Layout for the screen where users can add a new destination and view there already saved destinations -->

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/addDestinationLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    android:padding="16dp"
    tools:context=".TravelActivity">

<!-- ScrollView wraps the form to allow scrolling on smaller screens,
     Ensures content is scrollable when keyboard is visible-->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

<!-- Used as the content container inside scrollView -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

<!-- ImageView for displaying the destination image,
     Fixed size for a consistent UI -->
            <ImageView
                android:id="@+id/destinationImage"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginTop="24dp"
                android:scaleType="fitCenter"
                android:src="@drawable/world_icon"
                android:contentDescription="Destination Image" />

<!-- EditText for destination name input -->
            <EditText
                android:id="@+id/destinationName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:hint="Enter Destination Name"
                android:padding="8dp"
                android:textColor="@color/textPrimary"
                android:textSize="16sp"
                android:backgroundTint="@color/colorPrimary"
                android:maxLines="1"
                android:inputType="text" />

<!-- Multi-line EditText for destination description, -->
            <EditText
                android:id="@+id/destinationDescription"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="12dp"
                android:hint="Short Description"
                android:padding="8dp"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                android:backgroundTint="@color/colorPrimary"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:scrollbars="vertical" />

<!-- RatingBar for the user to rate the destination -->
            <!-- numStars and stepSize define the rating scale -->
            <RatingBar
                android:id="@+id/destinationRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:numStars="5"
                android:stepSize="1"
                android:rating="0"
                android:isIndicator="false" />

<!-- Multi-line EditText for destination activities -->
            <EditText
                android:id="@+id/destinationActivities"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="12dp"
                android:hint="Things to do here"
                android:padding="8dp"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                android:backgroundTint="@color/colorPrimary"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:scrollbars="vertical" />

<!-- Button to submit the destination form -->
            <Button
                android:id="@+id/btnAddDestination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Add Destination"
                android:backgroundTint="@color/colorAccent"
                android:textColor="@color/colorPrimary"
                android:textSize="18sp"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>